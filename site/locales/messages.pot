msgstr ""

#. table cell
msgctxt "before-you-start/global-settings"
msgid "Supports"
msgstr ""

#. table cell
msgctxt "before-you-start/global-settings"
msgid "**Print Settings › Support material**"
msgstr ""

#. table cell
msgctxt "before-you-start/global-settings"
